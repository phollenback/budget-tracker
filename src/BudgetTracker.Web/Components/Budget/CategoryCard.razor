@using BudgetTracker.Domain

<section class="category-card">
    <h2>@Category.Name</h2>
    @if (!string.IsNullOrWhiteSpace(Note))
    {
        <p class="note">@Note</p>
    }
    @foreach (var line in Category.Lines)
    {
        <LineRow @key="line.Name"
                 Name="@line.Name"
                 Amount="@line.Amount.ToInput()"
                 Changed="Changed" />
    }
</section>

@code {
    [Parameter, EditorRequired] public BudgetCategory Category { get; set; } = default!;
    [Parameter] public string? Note { get; set; }
    [Parameter] public EventCallback<(string Name, decimal? Amount)> Changed { get; set; }
}
