@using System.Globalization
@using BudgetTracker.Domain

<div class="month-nav">
    <button type="button" class="arrow" @onclick="OnPrevious" aria-label="Previous month">‹</button>

    <label class="month-field">
        <span>Budget month</span>
        <input type="month"
               value="@MonthValue"
               @onchange="OnMonthInput" />
    </label>

    <button type="button" class="arrow" @onclick="OnNext" aria-label="Next month">›</button>

    @if (ShowStatus)
    {
        <span class="status @(IsSubmitted ? "submitted" : "draft")">
            @(IsSubmitted ? "Submitted" : "Not submitted")
        </span>
    }

    @if (SavedMonths.Count > 0)
    {
        <label class="saved-field">
            <span>Saved months</span>
            <select @onchange="OnMonthInput">
                @if (SavedMonths.All(month => month.Period != Period))
                {
                    <option value="@MonthValue" selected>@Period</option>
                }
                @foreach (var month in SavedMonths)
                {
                    <option value="@ToMonthValue(month.Period)" selected="@(month.Period == Period)">
                        @month.Period — @(month.IsSubmitted ? "submitted" : "draft")
                    </option>
                }
            </select>
        </label>
    }
</div>

@code {
    [Parameter, EditorRequired] public MonthPeriod Period { get; set; } = default!;
    [Parameter] public bool IsSubmitted { get; set; }
    [Parameter] public bool ShowStatus { get; set; } = true;
    [Parameter] public IReadOnlyList<SavedMonth> SavedMonths { get; set; } = [];
    [Parameter] public EventCallback<MonthPeriod> PeriodChanged { get; set; }

    private string MonthValue => ToMonthValue(Period);

    private Task OnPrevious() => PeriodChanged.InvokeAsync(Period.Previous());

    private Task OnNext() => PeriodChanged.InvokeAsync(Period.Next());

    private Task OnMonthInput(ChangeEventArgs e)
    {
        if (!DateOnly.TryParseExact(
                $"{e.Value}-01",
                "yyyy-MM-dd",
                CultureInfo.InvariantCulture,
                DateTimeStyles.None,
                out var parsed))
        {
            return Task.CompletedTask;
        }

        return PeriodChanged.InvokeAsync(MonthPeriod.From(parsed));
    }

    private static string ToMonthValue(MonthPeriod period) => period.Start.ToString("yyyy-MM");
}
