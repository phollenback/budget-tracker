<div class="line-row">
    <label>@Name</label>
    <MoneyInput Value="Amount" ValueChanged="OnAmountChanged" AriaLabel="@Name" />
</div>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter] public decimal? Amount { get; set; }
    [Parameter] public EventCallback<(string Name, decimal? Amount)> Changed { get; set; }

    private Task OnAmountChanged(decimal? amount) =>
        Changed.InvokeAsync((Name, amount));
}
