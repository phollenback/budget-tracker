@page "/"
@page "/{Year:int}/{Month:int}"
@using BudgetTracker.Domain
@inject IBudgetWorksheetStore Store
@inject NavigationManager Navigation

<PageTitle>Monthly Budget — @PeriodLabel</PageTitle>

<div class="sheet">
    <header class="sheet-header">
        <div>
            <p class="form-id">29-3914</p>
            <h1>Monthly Budget</h1>
            <p class="lede">
                To complete your current financial profile, review your monthly expenses.
            </p>
        </div>
        <div class="identity">
            <label>
                Name
                <InputText @bind-Value="Form.Name" />
            </label>
            <label>
                Completed on
                <InputDate @bind-Value="Form.Date" />
            </label>
        </div>
    </header>

    <MonthNavigator Period="Form.Period"
                    IsSubmitted="Form.IsSubmitted"
                    SavedMonths="SavedMonths"
                    PeriodChanged="ChangeMonthAsync" />

    <section class="headline-metrics">
        <label class="metric metric-input">
            <span>Net Monthly Income</span>
            <MoneyInput Value="Form.NetMonthlyIncome"
                        ValueChanged="OnIncomeChanged"
                        AriaLabel="Net Monthly Income" />
        </label>
        <ComputedBox Label="Less Expenses" Value="LessExpenses" />
        <ComputedBox Label="Total Monthly Expenses" Value="TotalMonthlyExpenses" />
    </section>

    <div class="columns">
        <div class="column">
            <CategoryCard Title="Housing" Lines="Form.Housing" Changed="RefreshTotals" />
            <CategoryCard Title="Transportation" Lines="Form.Transportation" Changed="RefreshTotals" />
            <CategoryCard Title="Debt Payments" Lines="Form.Debt" Changed="RefreshTotals" />
            <CategoryCard Title="Health Care / Insurance"
                          Note="Not deducted from paycheck"
                          Lines="Form.HealthCare"
                          Changed="RefreshTotals" />
        </div>

        <div class="column">
            <CategoryCard Title="Household / Personal" Lines="Form.HouseholdPersonal" Changed="RefreshTotals" />
            <CategoryCard Title="Children" Lines="Form.Children" Changed="RefreshTotals" />

            <div class="bucket essential">
                <p class="bucket-title">Essential Expenses (60%)</p>
                <ComputedBox Label="Essential Expenses Subtotal" Value="EssentialSubtotal" />
            </div>

            <CategoryCard Title="Discretionary" Lines="Form.Discretionary" Changed="RefreshTotals" />

            <div class="bucket discretionary">
                <p class="bucket-title">Discretionary Expenses (20%)</p>
                <ComputedBox Label="Discretionary Expenses Subtotal" Value="DiscretionarySubtotal" />
            </div>

            <ComputedBox CssClass="@SurplusCss"
                         Label="Total Surplus / Deficit"
                         Value="SurplusOrDeficit" />

            <CategoryCard Title="Saving and Investing"
                          Note="Not deducted from paycheck"
                          Lines="Form.SavingAndInvesting"
                          Changed="RefreshTotals" />

            <div class="bucket saving">
                <p class="bucket-title">Saving and Investing (20%)</p>
                <ComputedBox Label="Saving and Investing Subtotal" Value="SavingSubtotal" />
            </div>
        </div>
    </div>

    <footer class="sheet-footer">
        <p class="footnote">
            The 20% includes both after-tax and pre-tax savings and investments,
            including contributions to employer-sponsored retirement plans.
        </p>
        <div class="actions">
            @if (!string.IsNullOrWhiteSpace(StatusMessage))
            {
                <p class="status-message">@StatusMessage</p>
            }
            <button type="button" class="submit" @onclick="SubmitAsync">
                @(Form.IsSubmitted ? "Update " : "Submit ")@PeriodLabel
            </button>
        </div>
    </footer>
</div>

@code {
    [Parameter] public int? Year { get; set; }
    [Parameter] public int? Month { get; set; }

    private BudgetForm Form { get; set; } = new();
    private IReadOnlyList<MonthWorksheetSummary> SavedMonths { get; set; } = [];
    private string? StatusMessage { get; set; }
    private bool _loaded;

    private string PeriodLabel => Form.Period.ToString("MMMM yyyy");

    protected override async Task OnParametersSetAsync()
    {
        var period = ResolvePeriod();
        if (Year != period.Year || Month != period.Month)
        {
            Navigation.NavigateTo($"/{period.Year}/{period.Month}", replace: true);
            return;
        }

        if (_loaded && Form.Period == period)
        {
            return;
        }

        Form = await Store.GetOrCreateAsync(period);
        SavedMonths = await Store.ListAsync();
        StatusMessage = null;
        _loaded = true;
        RefreshTotals();
    }

    private DateOnly ResolvePeriod()
    {
        if (Year is >= 2000 and <= 2100 && Month is >= 1 and <= 12)
        {
            return new DateOnly(Year.Value, Month.Value, 1);
        }

        return BudgetForm.FirstOfMonth(DateOnly.FromDateTime(DateTime.Today));
    }

    private async Task ChangeMonthAsync(DateOnly nextPeriod)
    {
        nextPeriod = BudgetForm.FirstOfMonth(nextPeriod);
        if (nextPeriod == Form.Period)
        {
            return;
        }

        if (Form.HasEntries || Form.IsSubmitted)
        {
            await Store.SaveAsync(Form, submit: false);
        }

        Navigation.NavigateTo($"/{nextPeriod.Year}/{nextPeriod.Month}");
    }

    private async Task SubmitAsync()
    {
        await Store.SaveAsync(Form, submit: true);
        SavedMonths = await Store.ListAsync();
        StatusMessage = $"{PeriodLabel} submitted.";
    }

    private MonthlyBudget Budget { get; set; } = MonthlyBudget.Open(MonthPeriod.From(DateOnly.FromDateTime(DateTime.Today)));

    private decimal? LessExpenses => Budget.LessExpenses.Amount;
    private decimal? TotalMonthlyExpenses => Budget.TotalMonthlyExpenses.Amount;
    private decimal? EssentialSubtotal => Budget.EssentialSubtotal.Amount;
    private decimal? DiscretionarySubtotal => Budget.DiscretionarySubtotal.Amount;
    private decimal? SavingSubtotal => Budget.SavingSubtotal.Amount;
    private decimal? SurplusOrDeficit => Budget.SurplusOrDeficit.Amount;
    private string SurplusCss => Budget.SurplusOrDeficit.IsDeficit ? "surplus deficit" : "surplus";

    private Task OnIncomeChanged(decimal? amount)
    {
        Form.NetMonthlyIncome = amount;
        RefreshTotals();
        return Task.CompletedTask;
    }

    private void RefreshTotals() => Budget = Form.ToDomain();
}
