targetScope = 'resourceGroup'

@description('Azure region for all resources.')
param location string = resourceGroup().location

@description('Globally unique App Service name.')
param appName string

@description('App Service plan name.')
param planName string

@description('Log Analytics workspace name.')
param logAnalyticsName string

@description('Application Insights component name.')
param appInsightsName string

@description('User-assigned managed identity name.')
param identityName string

param tags object = {}

@description('Linux App Service plan SKU name.')
param skuName string = 'P1v3'

@minValue(1)
param skuCapacity int = 1

@description('App runtime stack.')
param linuxFxVersion string = 'DOTNETCORE|9.0'

@description('GitHub org or user that owns the repo (for OIDC federated identity).')
param gitHubOrg string = 'phollenback'

@description('GitHub repository name.')
param gitHubRepo string = 'budget-tracker'

@description('Branch allowed to request tokens via OIDC.')
param gitHubBranch string = 'main'

@description('GitHub Environment name used by the deploy job.')
param gitHubEnvironment string

@description('Log Analytics retention in days.')
param logRetentionInDays int = 30

@description('Merged into production app settings. Use BudgetExperiment__Variant=All for one-app.')
param extraAppSettings object = {}

@description('Pin visitors to one slot after the first request. Used by A/B traffic routing.')
param clientAffinityEnabled bool = false

@description('Optional experiment slots: [{ name, variant, trafficPercent }]. Empty for production-only.')
param experimentSlots array = []

var websiteContributorRoleId = 'de139f84-1756-47ae-9be6-808fbbe84772'

var insightsAppSettings = {
  APPLICATIONINSIGHTS_CONNECTION_STRING: appInsights.properties.ConnectionString
  ApplicationInsightsAgent_EXTENSION_VERSION: '~3'
  XDT_MicrosoftApplicationInsights_Mode: 'Recommended'
}

resource logAnalytics 'Microsoft.OperationalInsights/workspaces@2023-09-01' = {
  name: logAnalyticsName
  location: location
  tags: tags
  properties: {
    sku: {
      name: 'PerGB2018'
    }
    retentionInDays: logRetentionInDays
  }
}

resource appInsights 'Microsoft.Insights/components@2020-02-02' = {
  name: appInsightsName
  location: location
  tags: tags
  kind: 'web'
  properties: {
    Application_Type: 'web'
    WorkspaceResourceId: logAnalytics.id
    IngestionMode: 'LogAnalytics'
    publicNetworkAccessForIngestion: 'Enabled'
    publicNetworkAccessForQuery: 'Enabled'
  }
}

resource identity 'Microsoft.ManagedIdentity/userAssignedIdentities@2023-01-31' = {
  name: identityName
  location: location
  tags: tags
}

resource githubBranchFederation 'Microsoft.ManagedIdentity/userAssignedIdentities/federatedIdentityCredentials@2023-01-31' = {
  parent: identity
  name: 'github-${gitHubBranch}'
  properties: {
    issuer: 'https://token.actions.githubusercontent.com'
    subject: 'repo:${gitHubOrg}/${gitHubRepo}:ref:refs/heads/${gitHubBranch}'
    audiences: [
      'api://AzureADTokenExchange'
    ]
  }
}

resource githubEnvironmentFederation 'Microsoft.ManagedIdentity/userAssignedIdentities/federatedIdentityCredentials@2023-01-31' = {
  parent: identity
  name: 'github-env-${gitHubEnvironment}'
  dependsOn: [
    githubBranchFederation
  ]
  properties: {
    issuer: 'https://token.actions.githubusercontent.com'
    subject: 'repo:${gitHubOrg}/${gitHubRepo}:environment:${gitHubEnvironment}'
    audiences: [
      'api://AzureADTokenExchange'
    ]
  }
}

resource plan 'Microsoft.Web/serverfarms@2024-11-01' = {
  name: planName
  location: location
  tags: tags
  kind: 'linux'
  sku: {
    name: skuName
    capacity: skuCapacity
  }
  properties: {
    reserved: true
  }
}

resource webApp 'Microsoft.Web/sites@2024-11-01' = {
  name: appName
  location: location
  tags: union(tags, {
    'hidden-link: /app-insights-resource-id': appInsights.id
  })
  kind: 'app,linux'
  identity: {
    type: 'UserAssigned'
    userAssignedIdentities: {
      '${identity.id}': {}
    }
  }
  properties: {
    serverFarmId: plan.id
    httpsOnly: true
    reserved: true
    clientAffinityEnabled: clientAffinityEnabled
    publicNetworkAccess: 'Enabled'
    autoGeneratedDomainNameLabelScope: 'TenantReuse'
    siteConfig: {
      linuxFxVersion: linuxFxVersion
      alwaysOn: true
      http20Enabled: true
      minTlsVersion: '1.2'
      scmMinTlsVersion: '1.2'
      ftpsState: 'Disabled'
      netFrameworkVersion: 'v4.0'
    }
  }
}

resource appSettings 'Microsoft.Web/sites/config@2024-11-01' = {
  parent: webApp
  name: 'appsettings'
  properties: union(insightsAppSettings, extraAppSettings)
}

resource webConfig 'Microsoft.Web/sites/config@2024-11-01' = {
  parent: webApp
  name: 'web'
  properties: {
    linuxFxVersion: linuxFxVersion
    alwaysOn: true
    http20Enabled: true
    minTlsVersion: '1.2'
    scmMinTlsVersion: '1.2'
    ftpsState: 'Disabled'
    netFrameworkVersion: 'v4.0'
    experiments: {
      rampUpRules: [for (slot, i) in experimentSlots: {
        name: slot.name
        actionHostName: slots[i].properties.defaultHostName
        reroutePercentage: slot.trafficPercent
      }]
    }
  }
}

resource ftpPublishing 'Microsoft.Web/sites/basicPublishingCredentialsPolicies@2024-11-01' = {
  parent: webApp
  name: 'ftp'
  properties: {
    allow: false
  }
}

resource scmPublishing 'Microsoft.Web/sites/basicPublishingCredentialsPolicies@2024-11-01' = {
  parent: webApp
  name: 'scm'
  properties: {
    allow: true
  }
}

resource webAppDeployAccess 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(webApp.id, identity.id, websiteContributorRoleId)
  scope: webApp
  properties: {
    principalId: identity.properties.principalId
    principalType: 'ServicePrincipal'
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', websiteContributorRoleId)
  }
}

resource slots 'Microsoft.Web/sites/slots@2024-11-01' = [for slot in experimentSlots: {
  parent: webApp
  name: slot.name
  location: location
  tags: tags
  kind: 'app,linux'
  identity: {
    type: 'UserAssigned'
    userAssignedIdentities: {
      '${identity.id}': {}
    }
  }
  properties: {
    serverFarmId: plan.id
    httpsOnly: true
    reserved: true
    publicNetworkAccess: 'Enabled'
    siteConfig: {
      linuxFxVersion: linuxFxVersion
      alwaysOn: true
      http20Enabled: true
      minTlsVersion: '1.2'
      scmMinTlsVersion: '1.2'
      ftpsState: 'Disabled'
      netFrameworkVersion: 'v4.0'
    }
  }
}]

resource slotAppSettings 'Microsoft.Web/sites/slots/config@2024-11-01' = [for (slot, i) in experimentSlots: {
  parent: slots[i]
  name: 'appsettings'
  properties: union(insightsAppSettings, {
    BudgetExperiment__Variant: slot.variant
  })
}]

resource slotSettingNames 'Microsoft.Web/sites/config@2024-11-01' = if (!empty(experimentSlots)) {
  parent: webApp
  name: 'slotConfigNames'
  properties: {
    appSettingNames: [
      'BudgetExperiment__Variant'
    ]
  }
}

output webAppName string = webApp.name
output webAppUrl string = 'https://${webApp.properties.defaultHostName}'
output appInsightsConnectionString string = appInsights.properties.ConnectionString
output identityClientId string = identity.properties.clientId
output identityResourceId string = identity.id
output slotUrls array = [for (slot, i) in experimentSlots: {
  name: slot.name
  url: 'https://${slots[i].properties.defaultHostName}'
}]
